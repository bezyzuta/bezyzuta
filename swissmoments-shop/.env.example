# Admin login (für /admin)
# ADMIN_PASSWORD frei wählbar. SESSION_SECRET = 32 zufällige Bytes,
# z.B. `openssl rand -hex 32`. Nicht teilen.
ADMIN_PASSWORD=changeMeNow!2026
SESSION_SECRET=replace_with_32_byte_random_hex_string
